# Copy to .env and fill in.

# Public URL of this server through Pangolin. No trailing slash.
MCP_BASE_URL=https://himalaya-mcp.example.com

# PocketID OIDC client (see README step 3).
POCKETID_CONFIG_URL=https://id.example.com/.well-known/openid-configuration
POCKETID_CLIENT_ID=

# Address and port Newt reaches. 127.0.0.1 when Newt runs on this host.
BIND_ADDR=127.0.0.1
HOST_PORT=8765

# Tool access per Himalaya's MCP flags.
HIMALAYA_ALLOW_WRITE=true
HIMALAYA_ALLOW_SEND=false

# Optional: serve only these accounts from himalaya.toml (comma-separated).
HIMALAYA_ACCOUNTS=

# Optional: redirect URIs OAuth clients may register (comma-separated).
# Empty = Claude's callbacks plus loopback on any port. See README "OAuth security".
ALLOWED_CLIENT_REDIRECT_URIS=
